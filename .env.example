# ============================================================
# PAKISTAN SUPER APP - ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pakistan_super_app?schema=public"

# Redis Configuration (Pub/Sub & Geospatial)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET="superapp_dev_access_secret_do_not_use_in_prod_12345"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="superapp_dev_refresh_secret_do_not_use_in_prod_67890"
JWT_REFRESH_EXPIRY="30d"

# Realtime / WebSockets
SOCKET_PORT=4000
SOCKET_CORS_ORIGIN="*"

# Map Providers (Decoupled MapService)
DEFAULT_MAP_PROVIDER="mock" # "mock" | "google" | "mapbox" | "osrm"
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# Payment Providers
DEFAULT_PAYMENT_GATEWAY="mock" # "mock" | "jazzcash" | "easypaisa" | "stripe"
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_SECRET_KEY=""

# SMS Gateway (Pakistan OTP)
SMS_PROVIDER="mock" # "mock" | "telestax" | "infobip"
SMS_API_KEY=""

# Admin Default Seed Credentials
ADMIN_DEFAULT_PHONE="+923001234567"
ADMIN_DEFAULT_EMAIL="admin@pakistansuperapp.pk"
